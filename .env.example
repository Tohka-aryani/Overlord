DATABASE_URL=postgresql://raven:raven@localhost:5432/darkweb
OLLAMA_BASE_URL=http://192.168.100.140:11434
OLLAMA_MODEL=llama3.2:latest
# Classify batch size for ingest + POST /api/ingest/classify-backfill (local catch-up).
MAX_CLASSIFY_PER_RUN=25
IPINFO_TOKEN=
CRON_SECRET=
NEXT_PUBLIC_CARTO_API_KEY=
# Telegram public-channel archive (RSS bridge — t.me/s redirects from servers).
TELEGRAM_CHANNELS=breachdetect
# TELEGRAM_RSS_BASE=https://tg.i-c-a.su/rss
# Apify Tor keyword scrape (replaces local SOCKS probes).
# Dummy / example token only — put the real token in .env (never commit).
APIFY_TOKEN=
APIFY_TOR_ACTOR_ID=igolaizola~tor-dark-web-scraper
# Max page hits per hourly run (keyword search results).
APIFY_TOR_MAX_ITEMS=10
TOR_KEYWORDS_FILE=data/tor-keywords.txt
# Run tor-sites every N ingest-loop cycles (default 4 ≈ hourly if cycle=15m).
INGEST_TOR_EVERY=4
